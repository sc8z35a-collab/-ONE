{
  "name": "inkshift-overpass",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/inkshift/*"]
  },
  "durable_objects": {
    "bindings": [{"name": "ROOMS", "class_name": "InkshiftRoom"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["InkshiftRoom"]}],
  "observability": {"enabled": true, "head_sampling_rate": 0.1}
}
